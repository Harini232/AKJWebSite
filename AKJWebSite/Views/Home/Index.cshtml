@{
	ViewData["Title"] = "Home Page";
}
<style>
	.text-gery {
		color: white;
	}

	.carousel-control-prev {
		background: #e87a2e;
	}

	.border-primary {
		border-color: #e87a2e !important;
	}

	.carousel-control-next {
		background: #e87a2e;
	}

	#carouselId .carousel-indicators li.active {
		background: #e87a2e !important;
	}

	.about-img::before {
		background: #e87a2e !important;
	}

	.about-img::after {
		background: #312a70 !important;
	}

	.bg-dark1 {
		background-color: #e87a2e !important;
	}

	.project-item::before {
		background: #e87a2e;
	}

	.project-item::after {
		background: #312a70 !important;
	}

	.project-item:hover a {
		background: #312a70 !important;
		color: white !important;
	}

	#carouselId .carousel-indicators li, #carouselId .carousel-indicators li{
		border: #e87a2e;
	}
	
</style>

<!-- Carousel Start -->
<div class="container-fluid carousel px-0 mb-5 pb-5" id="hero">
	<div id="carouselId" class="carousel slide" data-bs-ride="carousel">
		<ol class="carousel-indicators">
			<li data-bs-target="#carouselId" data-bs-slide-to="0" class="active" aria-current="true" aria-label="First slide"></li>
			<li data-bs-target="#carouselId" data-bs-slide-to="1" aria-label="Second slide"></li>
		</ol>
		<div class="carousel-inner" role="listbox">
			<div class="carousel-item active">
				<img src="https://www.cjpl.in/wp-content/uploads/2021/06/cctvbanner-1.jpg" class="img-fluid w-100" alt="First slide">
				<div class="carousel-caption">
					<div class="container carousel-content">
						<h4 class="text-gery mb-4 animated slideInDown">Welcome to A.K. ENTERPRISES </h4>
						<h1 class="text-gery display-1 mb-4 animated slideInDown"> Your Security Starts with Smart Vision.</h1>
						@* <a href="" class="me-2"><button type="button" class="px-5 py-3 btn btn-primary border-2 rounded-pill animated slideInDown">Read More</button></a> *@
					</div>
				</div>
			</div>
			<div class="carousel-item">
				<img src="https://newgatesecurity.com/wp-content/uploads/2020/01/global-network-coverage-world-map-truck-with-industrial-container-cargo-for-logistic-import-export-at_t20_9lRxBO.jpg" class="img-fluid w-100" alt="Second slide">
				<div class="carousel-caption">
					<div class="container carousel-content">
						@* <h4 class="text-gery mb-4 animated slideInDown">Welcome to A.K. ENTERPRISES </h4> *@
						<h1 class="text-gery display-1 mb-4 animated slideInDown">Empowering Mobility with Smart Solutions.</h1>
						@* <a href="" class="me-2"><button type="button" class="px-5 py-3 btn btn-primary border-2 rounded-pill animated slideInDown">Read More</button></a> *@
					</div>
				</div>
			</div>
		</div>
		<button class="carousel-control-prev btn btn-primary border border-2 border-start-0 border-primary" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
			<span class="carousel-control-prev-icon" aria-hidden="true"></span>
			<span class="visually-hidden">Previous</span>
		</button>
		<button class="carousel-control-next btn btn-primary border border-2 border-end-0 border-primary" type="button" data-bs-target="#carouselId" data-bs-slide="next">
			<span class="carousel-control-next-icon" aria-hidden="true"></span>
			<span class="visually-hidden">Next</span>
		</button>
	</div>
</div>
<!-- Carousel End -->
