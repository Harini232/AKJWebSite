									<i class="fas fa-school fa-4x text-primary"></i>
								</div>
								<div class="my-2">
									<h5>Secure </h5>
									<h5>Mobility</h5>
								</div>
							</div>
						</div>
						<div class="col-3">
							<div class="text-center">
								<div class="p-4 bg-dark1 rounded d-flex" style="align-items: center; justify-content: center;">
									<i class="fas fa-warehouse fa-4x text-primary"></i>
								</div>
								<div class="my-2">
									<h5>Track </h5>
									<h5>Vision</h5>
								</div>
							</div>
						</div>
						<div class="col-3">
							<div class="text-center">
								<div class="p-4 bg-dark1 rounded d-flex" style="align-items: center; justify-content: center;">
									<i class="fas fa-hospital fa-4x text-primary"></i>
								</div>
								<div class="my-2">
									<h5>Fleet</h5>
									<h5>Focus</h5>
